{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "varolisto-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // Sin subdominio *.workers.dev ni Preview URLs publicas:
  // el sitio se sirve unicamente por los custom domains de cada ambiente.
  "workers_dev": false,
  "preview_urls": false,

  "env": {
    "sandbox": {
      "name": "varolisto-website-sandbox",
      "workers_dev": false,
      "preview_urls": false,
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "varolisto-website-cache-sandbox",
        },
      ],
      // Rate limit de /api/colonias (proxy sin auth a COPOMEX, paquete prepagado).
      // El binding no hereda del bloque raiz: hay que declararlo por ambiente, y
      // con namespace_id distinto para que sandbox y produccion no compartan contador.
      // `period` solo admite 10 o 60 segundos.
      "ratelimits": [
        {
          "name": "RATE_LIMITER_COLONIAS",
          "namespace_id": "1002",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
    },
    "production": {
      "name": "varolisto-website-production",
      "workers_dev": false,
      "preview_urls": false,
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "varolisto-website-cache-prod",
        },
      ],
      // Rate limit de /api/colonias (proxy sin auth a COPOMEX, paquete prepagado).
      // El binding no hereda del bloque raiz: hay que declararlo por ambiente, y
      // con namespace_id distinto para que sandbox y produccion no compartan contador.
      // `period` solo admite 10 o 60 segundos.
      "ratelimits": [
        {
          "name": "RATE_LIMITER_COLONIAS",
          "namespace_id": "1001",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
    },
  },
}
