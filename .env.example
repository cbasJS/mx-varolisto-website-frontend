# Ambiente activo — controla qué URLs base se usan para cada API
# Valores: local | sandbox | production
# Si no se define, se infiere desde NODE_ENV (development→local, test→sandbox, production→production)
# Vercel: configurar como "sandbox" en Preview y "production" en Production
NEXT_PUBLIC_ENV=sandbox

# Copomex API — consulta de código postal
# Sandbox/local: usar token "pruebas" (oficial de Copomex para desarrollo)
# Producción: obtener un token real en https://copomex.com
COPOMEX_TOKEN=

# Telemetría — captura de geolocalización del dispositivo (Bloque 1.B v7)
# Default: false. Sólo encender cuando el aviso de privacidad esté actualizado.
# La autorización para activarlo en producción la da el CEO directamente.
# Valores válidos para activarlo: true | 1 | on | yes (case-insensitive).
NEXT_PUBLIC_TELEMETRIA_GEO_ENABLED=false
